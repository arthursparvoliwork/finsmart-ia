# =========================================================
# MODELO de arquivo de configuração - FinSmart IA
# =========================================================
# INSTRUÇÕES:
# 1. Copie este arquivo:  cp .env.example .env
# 2. Preencha com valores reais
# 3. NUNCA suba o .env pro GitHub (ele já tá no .gitignore)
# =========================================================

# Ambiente: development | testing | production
FLASK_ENV=development

# Chave secreta do JWT (USE UMA CHAVE LONGA E ALEATÓRIA em produção!)
# Gere uma nova em: https://randomkeygen.com/ (256-bit key)
JWT_SECRET=mude-isto-para-uma-chave-longa-e-aleatoria-em-producao-1234567890

# Tempo de expiração do token (em horas)
JWT_EXPIRE_HOURS=24

# Banco de dados SQLite (desenvolvimento). Em prod, troque por PostgreSQL.
DATABASE_URL=sqlite:///finsmart.db
